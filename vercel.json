{
  "version": 2,
  "builds": [
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "scripts/**", "use": "@vercel/static" },
    { "src": "artworks/**", "use": "@vercel/static" },
    { "src": "perf-budget.json", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/scripts/(.*)", "headers": { "Content-Type": "application/javascript" } },
    { "src": "/artworks/(.*)", "headers": { "Cache-Control": "public, max-age=31536000, immutable" } }
  ]
}
