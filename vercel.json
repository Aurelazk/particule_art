{
  "version": 2,
  "routes": [
    { "src": "/scripts/(.*)", "headers": { "Content-Type": "application/javascript" } },
    { "src": "/artworks/previews/(.*)", "headers": { "Cache-Control": "public, max-age=31536000, immutable" } },
    { "src": "/artworks/hd/(.*)", "headers": { "Cache-Control": "public, max-age=31536000, immutable" } },
    { "src": "/artworks/manifest.json", "headers": { "Cache-Control": "public, max-age=86400" } },
    { "src": "/sw.js", "headers": { "Cache-Control": "public, max-age=0, must-revalidate", "Service-Worker-Allowed": "/" } },
    { "src": "/(.*)", "status": 200, "dest": "/index.html" }
  ]
}
